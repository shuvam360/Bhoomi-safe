# ==============================================================================
# BhoomiSafe — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions: Copy this file to '.env' and populate with your credentials.
# Do NOT commit '.env' to version control.
# ==============================================================================

# ─── 1. Backend Security & Authentication ──────────────────────────────────
# Required secret key for administrative / operator endpoints:
# - PATCH /api/v1/reports/{id}/verify
# - POST  /api/v1/alerts
# - PATCH /api/v1/alerts/{id}/deactivate
BHOOMI_API_KEY=

# ─── 2. Multi-Tier Weather Feeds ───────────────────────────────────────────
# OpenWeatherMap API Key (Primary Feed)
# Sign up at: https://openweathermap.org/api
# Leave empty to automatically failover to India Meteorological Department (IMD)
OPENWEATHERMAP_API_KEY=

# India Meteorological Department (IMD) / South Asia Meteorological Endpoint
IMD_API_BASE_URL=

# ─── 3. Emergency Alert Services (Twilio SMS & SendGrid Email) ─────────────
# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=

# Twilio Auth Token
TWILIO_AUTH_TOKEN=

# Twilio Originating Phone Number (in E.164 format, e.g. +1234567890)
TWILIO_FROM_NUMBER=

# SendGrid API Key (starts with SG...)
SENDGRID_API_KEY=

# Alert Sender Email Address
ALERT_FROM_EMAIL=

# Emergency Management Recipient Email Address
ALERT_TO_EMAIL=

# ─── 4. Server Configuration ───────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
DEBUG=False
